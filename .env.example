# Copy to .env and fill in only what you use. Every integration is optional.

# ── Cloudflare R2 (optional) ─────────────────────────────────────────────
# `pnpm ready` uploads co-located post images/videos to this bucket.
# Leave all four empty to serve media from the site itself.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public URL of the bucket (custom domain or r2.dev URL), no trailing slash.
# When set, /blog/* and /raw/* media URLs point here. Also set it in your
# Cloudflare Pages environment variables so production builds use it.
ASSET_ORIGIN=

# ── CogSend social announcements (optional) ──────────────────────────────
# `pnpm blog:push` / `pnpm raw:push` announce new posts through your own
# CogSend instance. Platforms are set in site.config.js (cogsend.platforms).
COGSEND_API_URL=
COGSEND_API_KEY=

# ── Logging (optional) ───────────────────────────────────────────────────
# LOG_LEVEL=verbose   # or quiet
# NO_COLOR=1
