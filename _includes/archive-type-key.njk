{#- Shared type legend: green filled = blog, red hollow = note -#}
<p class="archive-type-key">
	<a class="archive-type-key-item" href="/blog/">
		<span class="entry-kind entry-kind-blog" aria-hidden="true"></span>
		<span class="archive-type-key-label">blog</span>
	</a>
	<span class="archive-type-key-desc">long-form posts</span>
	<span class="archive-key-sep">/</span>
	<a class="archive-type-key-item" href="/raw/">
		<span class="entry-kind entry-kind-note" aria-hidden="true"></span>
		<span class="archive-type-key-label">note</span>
	</a>
	<span class="archive-type-key-desc">short raw notes</span>
</p>
