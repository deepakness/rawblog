{%- if mastodon or metadata.author.email %}
<section class="post-comment-actions">
  <div class="comment-actions">
    {%- if mastodon %}
      <a class="comment-action" href="{{ mastodon }}" target="_blank" rel="noopener noreferrer">
        <span class="comment-action-icon" aria-hidden="true">{% phicon "chat-text" %}</span>
        Comment on Mastodon
      </a>
    {%- endif %}
    {%- if metadata.author.email %}
    <div class="email-popup-wrap">
      <button class="comment-action email-icon-btn" type="button" onclick="this.parentElement.classList.toggle('open')">
        <span class="comment-action-icon" aria-hidden="true">{% phicon "envelope-simple" %}</span>
        Comment via Email
      </button>
      <div class="email-popup email-popup--comment">
        <a href="https://mail.google.com/mail/?view=cm&to={{ metadata.author.email }}&su={{ ('Comment on: ' ~ title) | urlencode }}" target="_blank" rel="noopener noreferrer" onclick="this.closest('.email-popup-wrap').classList.remove('open')">
          <span class="email-popup-icon" aria-hidden="true">{% phicon "arrow-up-right" %}</span>
          <span>Open in Gmail</span>
        </a>
        <a href="mailto:{{ metadata.author.email }}?subject={{ ('Comment on: ' ~ title) | urlencode }}" onclick="this.closest('.email-popup-wrap').classList.remove('open')">
          <span class="email-popup-icon" aria-hidden="true">{% phicon "envelope-simple" %}</span>
          <span>Default email client</span>
        </a>
        <button type="button" onclick="navigator.clipboard.writeText('{{ metadata.author.email }}').then(()=>{const label=this.querySelector('.email-popup-label')||this;label.textContent='Email copied!';setTimeout(()=>{label.textContent='Copy email address';this.closest('.email-popup-wrap').classList.remove('open')},1000)})">
          <span class="email-popup-icon" aria-hidden="true">{% phicon "copy" %}</span>
          <span class="email-popup-label">Copy email address</span>
        </button>
      </div>
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}
